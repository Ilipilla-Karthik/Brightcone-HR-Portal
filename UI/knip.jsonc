{
  // Dead-code check: unused files, exports and dependencies. Run: npm run check:dead
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["e2e/**/*.spec.ts", "scripts/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignoreIssues": {
    // Generated by openapi-typescript; its unused helper types are expected.
    "src/api/schema.d.ts": ["types"],
    // knip wrongly reports forgotPassword as unused. It is imported by
    // features/auth/ForgotPasswordPage.tsx (the TypeScript build proves the import resolves).
    "src/api/auth.ts": ["exports"],
  },
  "ignoreDependencies": ["tailwindcss"],
}
